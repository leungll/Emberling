{
  "workflowId": "wf_serving_template",
  "name": "Photo Effect Serving Template",
  "description": "Apply one photo effect to a user's photo through the asynchronous image task path",
  "nodes": [
    {
      "id": "node_photo",
      "type": "image_input",
      "name": "User Photo",
      "position": {"x": 0, "y": 200},
      "config": {
        "inputKey": "photo",
        "label": "Photo",
        "required": true,
        "acceptedMediaTypes": ["image/png", "image/jpeg"],
        "maxSizeBytes": 5242880
      }
    },
    {
      "id": "node_request",
      "type": "text_input",
      "name": "User Request",
      "position": {"x": 0, "y": 0},
      "config": {"inputKey": "request", "label": "Request", "required": true}
    },
    {
      "id": "node_prompt",
      "type": "prompt_template",
      "name": "Effect Prompt",
      "position": {"x": 200, "y": 0},
      "config": {"template": "Restyle the photo as a soft watercolor illustration with warm light. {{text}}"}
    },
    {
      "id": "node_image",
      "type": "image_generation",
      "name": "Image Generation",
      "position": {"x": 400, "y": 100},
      "config": {"modelId": "image-model-v1", "width": 1024},
      "executionPolicy": {"timeoutMs": 60000, "maxAttempts": 2, "backoff": "FIXED"}
    },
    {
      "id": "node_output",
      "type": "media_output",
      "name": "Media Output",
      "position": {"x": 600, "y": 100},
      "config": {}
    }
  ],
  "edges": [
    {"id": "edge_request_prompt", "source": "node_request", "sourceHandle": "text", "target": "node_prompt", "targetHandle": "text"},
    {"id": "edge_photo_image", "source": "node_photo", "sourceHandle": "image", "target": "node_image", "targetHandle": "reference"},
    {"id": "edge_prompt_image", "source": "node_prompt", "sourceHandle": "text", "target": "node_image", "targetHandle": "prompt"},
    {"id": "edge_image_output", "source": "node_image", "sourceHandle": "image", "target": "node_output", "targetHandle": "image"},
    {"id": "edge_prompt_output", "source": "node_prompt", "sourceHandle": "text", "target": "node_output", "targetHandle": "caption"}
  ]
}
