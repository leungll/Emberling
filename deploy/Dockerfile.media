# Build context is services/media/. The media service runs on CPU with the Debian
# ffmpeg build, which carries libass for the subtitles filter, and a font for libass to
# render with. Dependencies are installed from the uv lockfile only.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid nonroot --create-home nonroot

COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /usr/local/bin/uv

WORKDIR /srv/media
ENV UV_PROJECT_ENVIRONMENT=/srv/media/.venv \
    UV_LINK_MODE=copy \
    UV_PYTHON=/usr/local/bin/python3.12 \
    UV_PYTHON_DOWNLOADS=never

# The lockfile layer is reused when only application code changes.
COPY pyproject.toml uv.lock .python-version README.md ./
RUN uv sync --frozen --no-dev

COPY app ./app

# Data and the downloaded transcription model live under one directory the compose
# stack mounts as a volume; it is created owned by nonroot so an empty volume inherits
# that ownership.
RUN mkdir -p /var/lib/emberling/media/data /var/lib/emberling/media/models \
    && chown -R nonroot:nonroot /var/lib/emberling/media
ENV MEDIA_DATA_DIR=/var/lib/emberling/media/data \
    HF_HOME=/var/lib/emberling/media/models \
    MEDIA_PORT=9201

USER nonroot:nonroot
EXPOSE 9201
ENTRYPOINT ["/srv/media/.venv/bin/python", "-m", "app"]
