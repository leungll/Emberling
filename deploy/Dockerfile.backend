# Build context is backend/. One Dockerfile builds every Backend binary: CMD selects the
# package under cmd/, so the Backend and the mock services cannot drift apart in base
# image, Go version or build flags.
ARG GO_VERSION=1.27.1

FROM golang:${GO_VERSION} AS build
ARG CMD=emberling
WORKDIR /src

# Dependencies are copied first so that a source-only change reuses the module layer.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/service ./cmd/${CMD}
# The operator's Execution Artifact sweeper ships in every image beside the selected
# binary, so it runs with the Backend's environment and mounted storage root, e.g.
# `docker compose run --rm --entrypoint /usr/local/bin/artifactsweep backend`.
RUN CGO_ENABLED=0 go build -trimpath -o /out/artifactsweep ./cmd/artifactsweep
RUN mkdir -p /out/assets /out/mockprovider /out/mockproduction
RUN mkdir -p /out/sandboxrunner

# Sandbox runner with the docker backend, for the local-only sandbox-docker compose
# profile. It is the one image that carries a docker CLI, which it uses to start each test
# container on the host daemon through a mounted socket. It is not the default target:
# the distroless stage below stays last so every other build is unchanged.
FROM docker:27.4.0-cli@sha256:561338cb111f09a755c9c28e00b66a2466a3dacd88bca6f2f0aeaf909e95730a AS sandboxrunner-docker
COPY --from=build /out/service /usr/local/bin/service
COPY --from=build /out/sandboxrunner /var/lib/emberling/sandboxrunner
ENTRYPOINT ["/usr/local/bin/service"]

# distroless/static has no shell and no package manager: the runtime image carries the
# binary and nothing that could read a mounted Secret interactively.
FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/service /usr/local/bin/service
COPY --from=build /out/artifactsweep /usr/local/bin/artifactsweep
# The asset storage root must exist and be owned by nonroot in the image: an empty named
# volume mounted here inherits that ownership, otherwise it is root-owned and the
# readiness write check fails.
COPY --from=build --chown=nonroot:nonroot /out/assets /var/lib/emberling/assets
# Same reason for the Mock Provider's dispatch record directory: the compose stack mounts a
# named volume here, and the record file must be writable by nonroot.
COPY --from=build --chown=nonroot:nonroot /out/mockprovider /var/lib/emberling/mockprovider
# Same reason for the mock production service's request record directory.
COPY --from=build --chown=nonroot:nonroot /out/mockproduction /var/lib/emberling/mockproduction
# Same reason for the sandbox runner's record directory.
COPY --from=build --chown=nonroot:nonroot /out/sandboxrunner /var/lib/emberling/sandboxrunner
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/service"]
