{
  "workflowId": "wf_21c74b07436f46a6a0384d13c80c6b5f",
  "version": 1,
  "name": "Photo Effect Template (photo-set)",
  "description": "An Agent applies one effect template across a photo set, reviews every generation, and delivers one reviewed example per photo",
  "nodes": [
    {
      "id": "node_brief",
      "type": "text_input",
      "name": "Creative Brief",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "label": "Creative Brief",
        "inputKey": "brief",
        "required": true
      }
    },
    {
      "id": "node_photos",
      "type": "media_brief",
      "name": "Photo Set",
      "position": {
        "x": 200,
        "y": 0
      },
      "config": {
        "inputKey": "photos"
      }
    },
    {
      "id": "node_agent",
      "type": "agent",
      "name": "Effect Template Agent",
      "position": {
        "x": 400,
        "y": 0
      },
      "config": {
        "modelId": "text-model-v1",
        "maxTurns": 16,
        "timeoutMs": 120000,
        "modelConfig": {
          "script": "photo-set",
          "temperature": 0.2
        },
        "allowedTools": [
          "generate_image",
          "review_asset",
          "generate_video"
        ],
        "imageModelId": "image-model-v1",
        "instructions": "Apply one shared set of effect settings to every photo. Generate each image, review every generation before using it, adjust the shared settings when a review fails, and render a short video from one reviewed asset. Finish with {\"examples\":[{\"photoAssetId\",\"assetRef\"}],\"settingsDigest\"}: one reviewed example per photo, all produced with the same settings.",
        "maxGenerationCalls": 12
      }
    },
    {
      "id": "node_result",
      "type": "media_result",
      "name": "Media Result",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {}
    },
    {
      "id": "node_output",
      "type": "media_output",
      "name": "Media Output",
      "position": {
        "x": 800,
        "y": 0
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "edge_brief_photos",
      "source": "node_brief",
      "sourceHandle": "text",
      "target": "node_photos",
      "targetHandle": "brief"
    },
    {
      "id": "edge_photos_agent",
      "source": "node_photos",
      "sourceHandle": "text",
      "target": "node_agent",
      "targetHandle": "input"
    },
    {
      "id": "edge_agent_result",
      "source": "node_agent",
      "sourceHandle": "text",
      "target": "node_result",
      "targetHandle": "text"
    },
    {
      "id": "edge_photos_result",
      "source": "node_photos",
      "sourceHandle": "text",
      "target": "node_result",
      "targetHandle": "brief"
    },
    {
      "id": "edge_result_image",
      "source": "node_result",
      "sourceHandle": "image",
      "target": "node_output",
      "targetHandle": "image"
    },
    {
      "id": "edge_result_caption",
      "source": "node_result",
      "sourceHandle": "caption",
      "target": "node_output",
      "targetHandle": "caption"
    }
  ],
  "runInputSchema": {
    "type": "object",
    "required": [
      "brief",
      "photos"
    ],
    "properties": {
      "brief": {
        "type": "string"
      },
      "photos": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "assetId",
            "mediaType",
            "sizeBytes",
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "minLength": 1
            },
            "assetId": {
              "type": "string",
              "minLength": 1
            },
            "mediaType": {
              "enum": [
                "image/jpeg",
                "image/png",
                "image/webp"
              ],
              "type": "string",
              "minLength": 1
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "maxItems": 12,
        "minItems": 1
      }
    },
    "additionalProperties": false
  },
  "validation": {
    "status": "VALID",
    "validatorVersion": "mvp-v1",
    "validatedAt": "2026-10-12T02:52:06.848039875Z"
  },
  "createdAt": "2026-10-12T02:52:06.848249Z"
}
