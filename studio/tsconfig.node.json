{
  "compilerOptions": {
    "target": "ES2023",
    // DOM is only needed for the Playwright specs under `tests/e2e`, which evaluate
    // callbacks inside a real browser (e.g. reading `HTMLImageElement.naturalWidth`).
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "playwright.config.ts", "eslint.config.js", "tests"]
}
